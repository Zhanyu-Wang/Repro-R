lmm <- lmer(waste ~ 1 + (1 | supplier), data=denim, REML=TRUE)
summary(lmm)
# Residuals vs fitted
plot(fitted(lmm), resid(lmm),
xlab="Fitted values", ylab="Residuals",
main="Residuals vs Fitted")
abline(h=0, lty=2)
# Normal Q‐Q of residuals
qqnorm(resid(lmm)); qqline(resid(lmm))
# Random effects Q‐Q
ranef_vals <- unlist(ranef(lmm)$supplier)
qqnorm(ranef_vals); qqline(ranef_vals)
aov_mod <- aov(waste ~ supplier, data=denim)
anova(aov_mod)
confint(lmm, parm="(Intercept)", level=0.95)
