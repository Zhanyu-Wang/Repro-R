data(mgus, package = "survival")
# Exclude pcdx and pctime, retain other variables
mgus_sub <- mgus[, !(names(mgus) %in% c("pcdx", "pctime"))]
mgus_clean <- mgus_sub[complete.cases(mgus_sub), ]
# Log-transform creat
mgus_clean$log_creat <- log(mgus_clean$creat)
# Martingale residuals for functional form
null_model <- coxph(Surv(futime, death) ~ 1, data = mgus_clean)
mgus_clean$martingale <- residuals(null_model, type = "martingale")
par(mfrow = c(2, 3))
with(mgus_clean, {
plot(age, martingale, main = "Age")
plot(hgb, martingale, main = "Hgb")
plot(log_creat, martingale, main = "Log Creatinine")
plot(mspike, martingale, main = "Mspike")
boxplot(martingale ~ sex, main = "Sex")
})
# PH assumption using cox.zph
full_model <- coxph(Surv(futime, death) ~ age + sex + hgb + log_creat + mspike, data = mgus_clean)
ph_test <- cox.zph(full_model)
print(ph_test)  # Check p-values for PH violation
plot(ph_test)   # Visual inspection of Schoenfeld residuals
# Full model
full_model <- coxph(Surv(futime, death) ~ age + sex + hgb + log_creat + mspike, data = mgus_clean)
# Stepwise selection
reduced_model <- step(full_model, direction = "both")
# Likelihood ratio test
anova(full_model, reduced_model)
summary(reduced_model)
