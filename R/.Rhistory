lmm <- lmer(waste ~ 1 + (1 | supplier), data=denim, REML=TRUE)
summary(lmm)
# Residuals vs fitted
plot(fitted(lmm), resid(lmm),
xlab="Fitted values", ylab="Residuals",
main="Residuals vs Fitted")
abline(h=0, lty=2)
# Normal Q‐Q of residuals
qqnorm(resid(lmm)); qqline(resid(lmm))
# Random effects Q‐Q
ranef_vals <- unlist(ranef(lmm)$supplier)
qqnorm(ranef_vals); qqline(ranef_vals)
aov_mod <- aov(waste ~ supplier, data=denim)
anova(aov_mod)
confint(lmm, parm="(Intercept)", level=0.95)
# mean
confint(lmm, parm="(Intercept)", level=0.95)
confint(lmm, oldNames=FALSE, level=0.95)
varcomp <- as.data.frame(VarCorr(lmm))
sigma_b2 <- varcomp$vcov[varcomp$grp=="supplier"]
sigma2   <- attr(VarCorr(lmm), "sc")^2
icc <- sigma_b2 / (sigma_b2 + sigma2)
lmm <- lmer(waste ~ 1 + (1 | supplier), data=denim, REML=TRUE)
# (2) Fit the fixed‐effects model
aov_mod <- aov(waste ~ supplier, data=denim)
# (3) Extract fitted values
fitted_mixed <- fitted(lmm)     # mu_hat + b_i_hat (BLUPs)
fitted_fixed <- fitted(aov_mod) # mu_hat + alpha_i_hat
# (4) Combine into a data frame for comparison
compare_fits <- data.frame(
supplier      = denim$supplier,
waste         = denim$waste,
fitted_mixed  = fitted_mixed,
fitted_fixed  = fitted_fixed
)
# (5) Show the first few rows
head(compare_fits, 10)
