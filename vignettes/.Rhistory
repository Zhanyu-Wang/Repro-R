odds_ratio <- (a * d) / (b * c)
se_log_ratio <- sqrt((1/a) + (1/b) + (1/c) + (1/d))
log_odds_ratio_CI <- log(odds_ratio) + c(-1.96, 1.96) * se_log_ratio
odds_ratio_CI <- exp(log_odds_ratio_CI)
print(odds_ratio_CI)
