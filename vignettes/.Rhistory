# import the given data
data <- data.frame(
Education = factor(rep(0:4, each = 3)),  # Assign education levels (0 = <HS, 1 = HS, ..., 4 = Grad)
Astrology = factor(rep(0:2, times = 5), ordered = TRUE),  # 0 = Not at all, 1 = Sort of, 2 = Very
Count = c(98, 84, 23,    # <HS
574, 286, 50,  # HS
122, 44, 4,    # Junior College
268, 57, 11,   # Bachelor
148, 23, 1)    # Graduate
)
model <- polr(Astrology ~ Education, data = data, weights = Count)
# Extract coefficients
beta_edu <- coef(model)["Education"]  # Beta coefficient for education
theta_01 <- model$zeta[1]  # Intercept for P(Y ≤ 0)
theta_12 <- model$zeta[2]  # Intercept for P(Y ≤ 1)
# Education level for "Graduate"
edu_level <- 4
# Compute cumulative log-odds
logit_01 <- theta_01 - (beta_edu * edu_level)  # Logit for P(Y ≤ 0)
logit_12 <- theta_12 - (beta_edu * edu_level)  # Logit for P(Y ≤ 1)
# Convert log-odds to cumulative probabilities
P_Y_leq_0 <- exp(logit_01) / (1 + exp(logit_01))  # P(Y ≤ 0)
P_Y_leq_1 <- exp(logit_12) / (1 + exp(logit_12))  # P(Y ≤ 1)
# Compute probabilities for each category
P_Y_0 <- P_Y_leq_0  # P(Y = 0)
P_Y_1 <- P_Y_leq_1 - P_Y_leq_0  # P(Y = 1)
P_Y_2 <- 1 - P_Y_leq_1  # P(Y = 2)
total_graduate <- sum(data$Count[data$Education == 4])
# Compute expected counts
expected_Y_0 <- P_Y_0 * total_graduate
expected_Y_1 <- P_Y_1 * total_graduate
expected_Y_2 <- P_Y_2 * total_graduate
print(expected_Y_0)
print(expected_Y_1)
print(expected_Y_2)
total_graduate
P_Y_0
P_Y_leq_0
exp(logit_01) / (1 + exp(logit_01))
logit_01
beta_edu
theta_01
theta_12
model
summary(model)
