data(death)
summary(death)
table(death$victim_race, death$defendant_race, death$death_penalty)
# Marginal frequencies of death penalty application
marginal_frequencies <- prop.table(table(death$death_penalty))
# Conditional frequencies: Death penalty given the race of the victim
conditional_freq_black_victim <- prop.table(table(death$death_penalty[death$victim_race == "Black"]))
conditional_freq_white_victim <- prop.table(table(death$death_penalty[death$victim_race == "White"]))
library(faraway)
data(death)
summary(death)
table(death$victim_race, death$defendant_race, death$death_penalty)
# Marginal frequencies of death penalty application
marginal_frequencies <- prop.table(table(death$death_penalty))
# Conditional frequencies: Death penalty given the race of the victim
conditional_freq_black_victim <- prop.table(table(death$death_penalty[death$victim_race == "Black"]))
conditional_freq_white_victim <- prop.table(table(death$death_penalty[death$victim_race == "White"]))
# Check the difference in death penalty applications for black and white defendants
marginal_black_defendant <- prop.table(table(death$death_penalty[death$defendant_race == "Black"]))
marginal_white_defendant <- prop.table(table(death$death_penalty[death$defendant_race == "White"]))
# Compare these with conditional distributions based on the victim's race
print(marginal_black_defendant)
print(marginal_white_defendant)
# Perform chi-square test for independence between race and death penalty
chisq_test <- chisq.test(table(death$victim_race, death$defendant_race, death$death_penalty))
